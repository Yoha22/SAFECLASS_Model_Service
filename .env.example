# ─────────────────────────────────────────────────────────────────────────────
# SAFECLASS Model Service — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# Path to the YOLOv8 weights file (relative to the project root).
# The file is NOT tracked in git. Place safeclass_best.pt in the root
# directory before running the service or docker build.
MODEL_PATH=safeclass_best.pt

# Minimum confidence score for a detection to be reported (0.50 – 0.95).
# Default: 0.75 (matches the trained model's optimal operating point).
# Can be updated at runtime via PUT /config/threshold.
CONFIDENCE_THRESHOLD=0.75

# Maximum frames per second to process from each RTSP stream.
# Reduce to lower CPU usage; increase for faster anomaly detection.
# Must be between 1 and 60.
MAX_FPS=15

# Google Drive file ID of safeclass_best.pt for automatic download in dev.
# Leave empty to skip automatic download and use a local file only.
# Example: if the Drive URL is https://drive.google.com/file/d/XXXX/view
# then GDRIVE_FILE_ID=XXXX
GDRIVE_FILE_ID=

# Secret API key that the backend Node.js service must include in every
# request as the HTTP header: X-API-Key: <value>
# Leave empty to disable authentication (development only — NOT safe for production).
BACKEND_API_KEY=change_this_to_a_strong_random_secret

# Base URL of the SAFECLASS backend.
# Used to POST webhook alerts when an anomaly is detected in a camera stream.
# POST {BACKEND_URL}/api/internal/alert
BACKEND_URL=http://localhost:3000

# Port on which the FastAPI service listens.
PORT=8001
